# ==============================================================================
# JARVIS ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# --- OpenAI Realtime API Settings ---
# Clave API de OpenAI (Obtén una en https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview
OPENAI_VOICE=alloy

# --- Google Gemini Live / AI Studio Settings ---
# Clave API de Google AI Studio (Obtén una en https://aistudio.google.com/)
GOOGLE_API_KEY=your_google_ai_studio_api_key_here
GEMINI_API_KEY=your_google_ai_studio_api_key_here
# Identificador oficial compatible con bidiGenerateContent / Live WebSocket
GEMINI_MODEL=gemini-3.1-flash-live-preview
GEMINI_VOICE=Puck

# --- Engine & Failover Orchestration ---
# Proveedor preferido al iniciar: OPENAI, GEMINI o AUTO
PREFERRED_PROVIDER=OPENAI
AUTO_FALLBACK=true

# --- Activación por Voz (Wake Word) ---
# Activar modo "En espera" hasta escuchar "Hola JARVIS", "Hey JARVIS", etc.
WAKE_WORD_ENABLED=true
WAKE_WORDS=hola jarvis,hey jarvis,jarvis,oye jarvis,ok jarvis
SLEEP_WORDS=gracias jarvis,descansa,adios jarvis,duermete,silencio jarvis,hasta luego
STANDBY_TIMEOUT_SECONDS=15

# --- Arquitectura de Memoria (Corto & Largo Plazo) ---
SHORT_TERM_MEMORY_MAX_TURNS=10
AUTO_MEMORY_EXTRACTION=true
CHROMA_PERSIST_DIR=./jarvis_db

# --- Audio Configuration ---
AUDIO_SAMPLE_RATE=24000